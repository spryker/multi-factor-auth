{% extends '@Gui/Layout/layout.twig' %}

{% block section_title %}{{ 'Set up Multi-Factor Authentication' | trans }}{% endblock %}

{% block content %}
    {% embed '@Gui/Partials/widget.twig' with { widget_title: 'Multi-Factor Authentication' | trans } %}
        {% block widget_content %}
            {% block guidance %}
                <div class="card border-0 bg-light mb-4" data-qa="mfa-setup-guidance">
                    <div class="card-body">
                        <h4 class="card-title mb-2">{{ 'Keep your account secure' | trans }}</h4>
                        <p class="text-muted mb-3">{{ 'Add an extra step when you sign in. After you enter your password, we ask for a one-time code. This way, only you can access your account, even if someone else knows your password.' | trans }}</p>
                        <ol class="list-unstyled mb-3">
                            {% for step in [
                                'Click "Activate" next to the method you want to use.',
                                'We send you a one-time code. For Email, check the inbox of the email address you use for this account.',
                                'Enter the code to confirm. From now on, you enter a new code after your password every time you sign in.',
                            ] %}
                                <li class="d-flex align-items-start mb-2">
                                    <span class="badge rounded-pill bg-primary me-2">{{ loop.index }}</span>
                                    <span>{{ step | trans }}</span>
                                </li>
                            {% endfor %}
                        </ol>
                        <div class="alert alert-info mb-0" role="note">{{ 'You can turn this off at any time by clicking "Deactivate". To confirm, we ask you for a code.' | trans }}</div>
                    </div>
                </div>
            {% endblock %}
            <div class="row">
                <div class="col-sm-12">
                    <div class="box">
                        <div class="box-body table-responsive no-padding">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th scope="col">{{ 'Type' | trans }}</th>
                                        <th scope="col">{{ 'Status' | trans }}</th>
                                        <th scope="col">{{ 'Actions' | trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for method in multiFactorAuthCollection.multiFactorAuthTypes %}
                                        {% if not method.status %}
                                            {% set label = 'Inactive' | trans %}
                                            {% set formName = 'activateForm' %}
                                            {% set actionPath = url('/multi-factor-auth/user-management/activate', {'type': method.type}) %}
                                            {% set csrfToken = csrf_token_activate %}
                                            {% set buttonText = 'Activate' | trans %}
                                            {% set flowType = 'is_activation' %}
                                            {% set buttonClass = 'btn-success' %}
                                        {% else %}
                                            {% set label = 'Active' | trans %}
                                            {% set formName = 'deactivateForm' %}
                                            {% set actionPath = url('/multi-factor-auth/user-management/deactivate', {'type': method.type}) %}
                                            {% set csrfToken = csrf_token_deactivate %}
                                            {% set buttonText = 'Deactivate' | trans %}
                                            {% set flowType = 'is_deactivation' %}
                                            {% set buttonClass = 'btn-danger' %}
                                        {% endif %}
                                        <tr data-qa="mfa-type-section">
                                            <td>{{ method.type | capitalize }}</td>
                                            <td>
                                                <span class="badge {{ method.status ? 'bg-success' : 'bg-secondary' }}">{{ label }}</span>
                                            </td>
                                            <td>
                                                <form name="{{ formName }}" class="js-form-{{ method.type }}" method="post" action="{{ actionPath | raw }}">
                                                    <input type="hidden" name="_csrf_token" value="{{ csrfToken }}">
                                                    <button class="btn btn-sm {{ buttonClass }}">{{ buttonText }}</button>
                                                </form>

                                                {% set url = "/multi-factor-auth/user/get-enabled-types?#{flowType}=true&type_to_set_up=#{method.type}" %}
                                                {% include '@MultiFactorAuth/Partials/multi-factor-authentication-handler.twig' ignore missing with {
                                                    url: url,
                                                    formSelector: ".js-form-#{method.type}",
                                                    modalId: "modal-id-#{method.type}",
                                                } %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}
